# ── Backend Production Environment ────────────────────────────────────────────
# Copy to .env.production and fill every value before deploying.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# ── Strapi security secrets (REQUIRED — use unique random values) ──────────────
# Four comma-separated base64 strings, e.g. key1,key2,key3,key4
APP_KEYS=<generate-4-random-base64-strings-comma-separated>

API_TOKEN_SALT=<generate-random-base64-string>
ADMIN_JWT_SECRET=<generate-random-base64-string>
TRANSFER_TOKEN_SALT=<generate-random-base64-string>
JWT_SECRET=<generate-random-base64-string>

# ── Database ────────────────────────────────────────────────────────────────────
# Must match the volume mount path in docker-compose.yml
DATABASE_FILENAME=/data/data.db

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins — no trailing slash
FRONTEND_URL=https://yourdomain.com

# ── Portal user auto-created on first boot ─────────────────────────────────────
# Leave blank to skip creation (recommended after first deploy)
PORTAL_USER_EMAIL=admin@yourdomain.com
PORTAL_USER_NAME=siteadmin
PORTAL_USER_PASSWORD=<strong-unique-password>
