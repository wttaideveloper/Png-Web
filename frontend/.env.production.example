# ── Frontend Production Environment ────────────────────────────────────────────
# This file is read by docker-compose.yml as a build argument.
# VITE_* variables are baked into the React bundle at build time by Vite.
# They CANNOT be changed after the image is built.
#
# Usage:
#   1. Copy to .env.production in the frontend/ folder:
#        cp frontend/.env.production.example frontend/.env.production
#   2. Also copy to the project ROOT as .env so docker-compose can read it:
#        cp frontend/.env.production.example .env
#   3. Fill in your actual domain, then run:
#        docker compose build
#        docker compose up -d

# URL of the Strapi API — must be publicly reachable from the browser.
# Since nginx proxies /api → backend:1337, use your domain + /api path.
VITE_STRAPI_API_URL=https://yourdomain.com/api
